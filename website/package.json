    "astro": "^5.0.0",
    "codemirror": "^6.0.2",
    "katex": "^0.17.0",
    "mermaid": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
