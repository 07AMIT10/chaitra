---
import { DRISHTI_LENSES } from "../../lib/drishti-lenses";

interface Props {
  activeSlug?: string;
  basePath?: string;
  variant?: "sidebar" | "rail";
}

const { activeSlug, basePath = "/drishti/lenses", variant = "sidebar" } = Astro.props;
const activeIndex = activeSlug
  ? DRISHTI_LENSES.findIndex((l) => l.slug === activeSlug)
  : -1;
---

<nav
  class:list={["lens-nav", { "lens-nav--rail": variant === "rail", "lens-nav--sidebar": variant === "sidebar" }]}
  aria-label="Drishti lenses"
>
  {activeIndex >= 0 && variant === "sidebar" && (
    <p class="lens-nav__status">
      Lens {activeIndex + 1} of {DRISHTI_LENSES.length} — {DRISHTI_LENSES[activeIndex].title}
    </p>
  )}
  <ul class="lens-nav__list">
    {DRISHTI_LENSES.map((lens, i) => (
      <li>
        <a
          class:list={["lens-nav__link", { "lens-nav__link--active": lens.slug === activeSlug }]}
          href={`${basePath}/${lens.slug}`}
          aria-current={lens.slug === activeSlug ? "page" : undefined}
        >
          <span class="lens-nav__num">{i + 1}</span>
          <span class="lens-nav__label">{lens.title}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .lens-nav {
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid color-mix(in srgb, var(--color-drishti) 25%, transparent);
    font-size: var(--font-size-sm);
  }

  .lens-nav--sidebar {
    position: sticky;
    top: var(--space-4);
  }

  .lens-nav--rail {
    position: sticky;
    top: 0;
    z-index: 2;
    margin-bottom: var(--space-4);
    padding-block: var(--space-2);
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(8px);
  }

  .lens-nav__status {
    margin: 0 0 var(--space-3);
    font-weight: 600;
    color: var(--color-drishti);
    font-size: 0.8rem;
  }

  .lens-nav__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .lens-nav--rail .lens-nav__list {
    flex-direction: row;
    gap: var(--space-2);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    padding-bottom: var(--space-1);
  }

  .lens-nav--rail .lens-nav__list::-webkit-scrollbar {
    height: 4px;
  }

  .lens-nav--rail .lens-nav__list li {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .lens-nav__link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0.5rem 0.65rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--color-muted);
  }

  .lens-nav--rail .lens-nav__link {
    min-height: 44px;
    padding: 0.45rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-drishti) 20%, transparent);
    white-space: nowrap;
  }

  .lens-nav__link:hover {
    color: var(--color-drishti-hover);
    background: var(--color-drishti-subtle);
  }

  .lens-nav__link--active {
    color: var(--color-text);
    background: var(--color-drishti-subtle);
    font-weight: 600;
  }

  .lens-nav--rail .lens-nav__link--active {
    border-color: var(--color-drishti);
  }

  .lens-nav__num {
    flex-shrink: 0;
    width: 1.25rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-drishti);
  }

  .lens-nav--rail .lens-nav__label {
    font-size: 0.8rem;
  }

  @media (min-width: 60rem) {
    .lens-nav--rail {
      display: none;
    }
  }
</style>
