---
import { DRISHTI_LENSES } from "../../lib/drishti-lenses";
---

<nav class="lens-section-jump" aria-label="Jump to lens section">
  <p class="lens-section-jump__label">On this study</p>
  <ul class="lens-section-jump__list">
    {DRISHTI_LENSES.map((lens, i) => (
      <li>
        <a class="lens-section-jump__link" href={`#lens-${lens.slug}`}>
          <span class="lens-section-jump__num">{i + 1}</span>
          <span>{lens.title}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .lens-section-jump {
    position: sticky;
    top: 0;
    z-index: 2;
    margin: 0 0 var(--space-4);
    padding: var(--space-2) 0;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(8px);
  }

  .lens-section-jump__label {
    margin: 0 0 var(--space-2);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-drishti);
  }

  .lens-section-jump__list {
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 0 0 var(--space-1);
    list-style: none;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  .lens-section-jump__list::-webkit-scrollbar {
    height: 4px;
  }

  .lens-section-jump__list li {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .lens-section-jump__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in srgb, var(--color-drishti) 20%, transparent);
    background: var(--color-surface);
    text-decoration: none;
    color: var(--color-muted);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .lens-section-jump__link:hover {
    color: var(--color-drishti-hover);
    border-color: var(--color-drishti);
    background: var(--color-drishti-subtle);
  }

  .lens-section-jump__link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .lens-section-jump__num {
    font-variant-numeric: tabular-nums;
    color: var(--color-drishti);
    font-weight: 600;
  }

  @media (min-width: 60rem) {
    .lens-section-jump {
      display: none;
    }
  }
</style>
