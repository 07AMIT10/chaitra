      "slug": "blood-circulation",
      "folder": "BLOOD_CIRCULATION",
      "title": "Blood Circulation",
      "tagline": "A closed-loop delivery network with a central pump",
      "tldr": [
        "Blood is a transport layer for O₂, nutrients, and signals.",
        "The heart schedules work; vessels are queues with capacity limits.",
        "Blockages are bottlenecks — local failures become global."
      ],
      "relatedTopics": [
        "queueing-theory",
        "streaming-algorithms",
        "rate-limiting"
      ],
      "atAGlance": {
        "flows": "Oxygen in, CO₂ out, nutrients everywhere",
        "optimizes": "Perfusion to demanding organs",
        "persists": "Closed circuit topology, hemoglobin chemistry",
        "likelyFuture": "Compensation until decompensation"
      },
      "hasPage": true
    },
    {
      "slug": "sleep",
      "folder": "SLEEP",
      "title": "Sleep",
      "tagline": "The brain's nightly maintenance and memory compiler",
      "tldr": [
        "Sleep is regulated feedback, not a single switch.",
        "The brain clears waste, consolidates memory, and resets learning capacity.",
        "Sleep debt is a queue — you cannot delete it, only drain it."
      ],
      "relatedTopics": [
        "statistical-learning",
        "queueing-theory",
        "bayesian-inference-systems"
      ],
      "atAGlance": {
        "flows": "Metabolic waste clearance, glucose, neural activity patterns",
        "optimizes": "Next-day performance and long-term memory",
        "persists": "Circadian rhythm, sleep architecture stages",
        "likelyFuture": "Personalized chronotherapy; wearables as early warning"
      },
      "hasPage": true
    },
