  "studies": [
    {
      "slug": "blood-circulation",
      "folder": "BLOOD_CIRCULATION",
      "title": "Blood Circulation",
      "tagline": "A closed-loop delivery network with a central pump",
      "phenomenon": "A closed loop where the heart schedules and vessels queue",
      "tldr": [
        "Blood is a transport layer for O₂, nutrients, and signals.",
        "The heart schedules work; vessels are queues with capacity limits.",
        "Blockages are bottlenecks — local failures become global."
      ],
      "relatedTopics": [
        "queueing-theory",
        "streaming-algorithms",
        "rate-limiting"
      ],
      "atAGlance": {
        "flows": "Oxygen in, CO₂ out, nutrients everywhere",
        "optimizes": "Perfusion to demanding organs",
        "persists": "Closed circuit topology, hemoglobin chemistry",
        "likelyFuture": "Compensation until decompensation"
      },
      "hasPage": true
    },
    {
      "slug": "global-supply-chains",
      "folder": "GLOBAL_SUPPLY_CHAINS",
      "title": "Global Supply Chains",
      "tagline": "The physical queueing network routing goods across the planet",
      "phenomenon": "Atoms routed across the planet behind a Buy Now illusion",
      "tldr": [
        "A container ship is a moving warehouse — lean inventory removed the shock absorbers.",
        "Canals and ports are rate limiters; one jam starves everything downstream.",
        "Watch port dwell time, not press releases, to see if resilience is real."
      ],
      "relatedTopics": [
        "queueing-theory",
        "eventual-consistency",
        "mapreduce"
      ],
      "atAGlance": {
        "flows": "Containers, invoices, raw materials, finished goods",
        "optimizes": "Cost per unit and capital velocity",
        "persists": "Ocean transit time, crane physics, geography",
        "likelyFuture": "Regional buffers return; lean JIT loses another round"
      },
      "hasPage": true
    },
    {
      "slug": "internet-routing",
      "folder": "INTERNET_ROUTING",
      "title": "Internet Routing",
      "tagline": "No center — just routers gossiping paths to neighbors",
      "phenomenon": "The internet is a map nobody owns, rebuilt every time a cable breaks",
      "tldr": [
        "There is no center — routing is routers trusting neighbor gossip.",
        "A misconfigured BGP announcement can black-hole YouTube for an hour.",
        "Watch hijack frequency and peering diversity, not press releases about resilience."
      ],
      "relatedTopics": [
        "gossip-protocols",
        "token-routing",
        "scalable-architectures"
      ],
      "atAGlance": {
        "flows": "IP packets, BGP updates, light pulses in fiber",
        "optimizes": "Reachability at lowest hop count",
        "persists": "TCP/IP, BGP, and glass under oceans",
        "likelyFuture": "Private backbones bypass public gossip"
      },
      "hasPage": true
    },
    {
      "slug": "photosynthesis",
      "folder": "PHOTOSYNTHESIS",
      "title": "Photosynthesis",
      "tagline": "The leaf-scale engine feeding every food chain",
      "phenomenon": "Sunlight converted to sugar one chloroplast at a time",
      "tldr": [
        "A leaf is a solar panel you can pick — chloroplasts do the conversion.",
        "Water from roots, not sunshine, is usually the bottleneck.",
        "Track growing-season water tables to forecast crop stress, not hype cycles."
      ],
      "relatedTopics": [
        "scalable-architectures",
        "information-theory",
        "distributed-systems"
      ],
      "atAGlance": {
        "flows": "Photons, water, CO₂, glucose, oxygen",
        "optimizes": "Sugar per acre and reproduction success",
        "persists": "Chloroplast biochemistry across all green plants",
        "likelyFuture": "Engineered yield gains vs heat-stress losses"
      },
      "hasPage": true
    },
    {
      "slug": "power-grids",
      "folder": "POWER_GRIDS",
      "title": "Power Grids",
      "tagline": "A continent juggling megawatts with nowhere to stash the spare",
      "phenomenon": "A continent juggling megawatts with nowhere to store the spare",
      "tldr": [
        "The grid is synchronized spinning metal — not a tank of electricity waiting to pour.",
        "Generation must match demand every second or frequency drifts off 60 Hz.",
        "Watch reserve margins and line thermal ratings, not renewable percentage press releases."
      ],
      "relatedTopics": [
        "scalable-architectures",
        "probability-theory",
        "distributed-systems"
      ],
      "atAGlance": {
        "flows": "Electrons as waves, phase signals, reactive power",
        "optimizes": "Frequency stability and voltage balance",
        "persists": "60/50 Hz physics and Kirchhoff's laws",
        "likelyFuture": "Virtual power plants from rooftops and EVs"
      },
      "hasPage": true
    },
    {
      "slug": "sleep",
      "folder": "SLEEP",
      "title": "Sleep",
      "tagline": "The brain's nightly maintenance and memory compiler",
      "phenomenon": "Sleep debt is a queue you can't delete — only drain",
      "tldr": [
        "Sleep is regulated feedback, not a single switch.",
        "The brain clears waste, consolidates memory, and resets learning capacity.",
        "Sleep debt is a queue — you cannot delete it, only drain it."
      ],
      "relatedTopics": [
        "statistical-learning",
        "queueing-theory",
        "bayesian-inference-systems"
      ],
      "atAGlance": {
        "flows": "Metabolic waste clearance, glucose, neural activity patterns",
        "optimizes": "Next-day performance and long-term memory",
        "persists": "Circadian rhythm, sleep architecture stages",
        "likelyFuture": "Personalized chronotherapy; wearables as early warning"
      },
      "hasPage": true
    },
    {
      "slug": "the-immune-system",
      "folder": "THE_IMMUNE_SYSTEM",
      "title": "The Immune System",
      "tagline": "Billions of cells with no boss, learning who to attack",
      "phenomenon": "A body that trains defenders by shuffling DNA and killing mistakes",
      "tldr": [
        "No central command — macrophages, T-cells, and B-cells bump and read molecular tags.",
        "Autoimmune disease is friendly fire when self/non-self classification fails.",
        "Watch flare frequency and recovery time, not supplement marketing."
      ],
      "relatedTopics": [
        "spam-detection",
        "large-scale-multi-agent-systems",
        "statistical-learning"
      ],
      "atAGlance": {
        "flows": "White blood cells, cytokines, antigens, antibodies",
        "optimizes": "Neutralize threats without destroying the host",
        "persists": "V(D)J recombination blueprint and memory cells",
        "likelyFuture": "Programmable mRNA and CAR-T precision"
      },
      "hasPage": true
    },
    {
      "slug": "the-office-as-a-computer",
      "folder": "THE_OFFICE_AS_A_COMPUTER",
      "title": "The Office as a Computer",
      "tagline": "A room that converts energy into information",
      "phenomenon": "A room that converts electricity into decisions",
      "tldr": [
        "The office is an energy→information conversion machine.",
        "Employees, email, and docs form a distributed computer.",
        "Most structure is shared agreement, not physical matter."
      ],
      "relatedTopics": [
        "gossip-protocols",
        "queueing-theory",
        "information-theory",
        "large-scale-multi-agent-systems"
      ],
      "atAGlance": {
        "flows": "Electricity, attention, email, Slack, decisions",
        "optimizes": "Throughput of revenue-generating information",
        "persists": "Legal entity, brand, API contracts, org chart agreements",
        "likelyFuture": "AI agents as coworkers; hybrid remote equilibrium"
      },
      "hasPage": true
    },
    {
      "slug": "urban-traffic-networks",
      "folder": "URBAN_TRAFFIC_NETWORKS",
      "title": "Urban Traffic Networks",
      "tagline": "Asphalt graphs where cars are packets you can't drop",
      "phenomenon": "A grid where cars are packets you can't drop when the queue backs up",
      "tldr": [
        "A traffic jam is a wave — you can't point to it, only cars trapped inside it.",
        "Throughput is set by the slowest intersection, not the fastest highway.",
        "Watch bottleneck clearing rate and induced-demand studies, not lane-count headlines."
      ],
      "relatedTopics": [
        "queueing-theory",
