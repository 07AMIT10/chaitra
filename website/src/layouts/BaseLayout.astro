---
import "../styles/tokens.css";
const { title = "Chaitra" } = Astro.props;
const description = "Learn probabilistic data structures and distributed systems through interactive labs, runnable code, and narrative explanations — from Bloom filters to transformer attention.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="51 topics · 34 interactive labs · From Bloom filters to transformer attention." />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0f1419" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
    />
    <slot name="head" />
  </head>
  <body>
    <header role="banner">
      <nav aria-label="Site">
        <a href="/">Chaitra</a> · <a href="/catalog">Catalog</a>
      </nav>
    </header>
    <main id="main-content"><slot /></main>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    padding: var(--space-4);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    line-height: 1.5;
  }

  header nav a {
    color: var(--color-accent);
  }

  header nav a:hover {
    color: var(--color-accent-hover);
  }

  header nav a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: 2px;
  }

  main a:link {
    color: var(--color-accent);
  }

  main a:visited {
    color: color-mix(in srgb, var(--color-accent) 78%, var(--color-text));
  }

  main a:hover {
    color: var(--color-accent-hover);
  }

  main a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: 2px;
  }
</style>
