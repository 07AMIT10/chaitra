---
import "../styles/tokens.css";
import ThemeToggle from "../components/ThemeToggle.tsx";

const { title = "Chaitra" } = Astro.props;
const description = "Learn probabilistic data structures and distributed systems through interactive labs, runnable code, and narrative explanations — from Bloom filters to transformer attention.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="51 topics · 34 interactive labs · From Bloom filters to transformer attention." />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0f1419" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
    />
    <slot name="head" />
  </head>
  <body>
    <header role="banner" class="site-header">
      <nav aria-label="Site">
        <a href="/">Chaitra</a> · <a href="/catalog">Catalog</a>
      </nav>
      <ThemeToggle client:visible />
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer" role="contentinfo">
      <p>
        <a href="/catalog">Catalog</a>
        ·
        <a href="https://github.com/07AMIT10/chaitra">GitHub</a>
        · MIT-style open curriculum
      </p>
    </footer>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    padding: var(--space-4);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    line-height: 1.5;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .site-header nav a {
    color: var(--color-accent);
  }

  .site-header nav a:hover {
    color: var(--color-accent-hover);
  }

  .site-header nav a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: 2px;
  }

  .theme-toggle {
    font: inherit;
    font-size: var(--font-size-sm);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, var(--color-muted) 40%, transparent);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--color-accent);
  }

  .theme-toggle:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  #main-content {
    flex: 1;
  }

  .site-footer {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid color-mix(in srgb, var(--color-muted) 25%, transparent);
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  .site-footer a {
    color: var(--color-accent);
  }

  main a:link {
    color: var(--color-accent);
  }

  main a:visited {
    color: color-mix(in srgb, var(--color-accent) 78%, var(--color-text));
  }

  main a:hover {
    color: var(--color-accent-hover);
  }

  main a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: 2px;
  }
</style>
