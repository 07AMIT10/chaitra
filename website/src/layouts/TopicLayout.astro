---
import BaseLayout from "./BaseLayout.astro";
import MermaidInit from "../components/MermaidInit.tsx";
import "../styles/narrative.css";
import "../styles/topic-page.css";

const { title, repoFolder, pyodide = false, hasLab = false, hasCode = false } = Astro.props;
const PYODIDE_VERSION = "0.26.4";
const PYODIDE_CDN = `https://cdn.jsdelivr.net/pyodide/v${PYODIDE_VERSION}/full/`;
---
<BaseLayout title={title}>
  {pyodide && (
    <>
      <link slot="head" rel="preload" href={`${PYODIDE_CDN}pyodide.asm.wasm`} as="fetch" crossorigin="anonymous" />
      <script slot="head" src={`${PYODIDE_CDN}pyodide.js`} crossorigin="anonymous"></script>
    </>
  )}
  <div class="topic-page">
  <a class="skip-link" href="#narrative">Skip to content</a>
  <nav class="topic__breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span class="topic__separator">/</span>
    <a href="/catalog">Catalog</a>
    <span class="topic__separator">/</span>
    <span class="topic__current">{title}</span>
  </nav>
  <div class="topic-layout">
    <aside class="topic__toc" aria-label="On this page">
      <p class="topic__toc-title">On this page</p>
      <ul>
        <li><a href="#narrative">Story</a></li>
        {hasLab && <li><a href="#lab">Lab</a></li>}
        {hasCode && <li><a href="#code">Code</a></li>}
        <li><a href={`https://github.com/07AMIT10/chaitra/tree/main/topics/${repoFolder}`}>GitHub</a></li>
      </ul>
    </aside>
  <article class="topic" aria-labelledby="topic-page-title">
    <h1 id="topic-page-title" class="topic__title">{title}</h1>
    <nav class="topic__jump" aria-label="Topic sections">
      <a href="#narrative">Story</a>
      {hasLab && <> · <a href="#lab">Lab</a></>}
      {hasCode && <> · <a href="#code">Code</a></>}
    </nav>
    {Astro.slots.has("hero") && (
      <section id="hero" aria-label="Overview">
        <slot name="hero" />
      </section>
    )}
    {Astro.slots.has("prerequisites") && (
      <section id="prerequisites" aria-label="Prerequisites">
        <slot name="prerequisites" />
      </section>
    )}
    <section id="narrative" aria-label="Topic narrative" tabindex="-1">
      <div class="topic__narrative prose">
        <slot name="narrative" />
      </div>
      <MermaidInit client:load />
    </section>
    {Astro.slots.has("lab") && (
      <section id="lab" aria-label="Interactive lab">
        <slot name="lab" />
      </section>
    )}
    {hasCode && (
      <section id="code" aria-label="Implementation code">
        <slot name="code" />
      </section>
    )}
    <footer class="topic__footer">
      <a href={`https://github.com/07AMIT10/chaitra/tree/main/topics/${repoFolder}`}>View on GitHub</a>
    </footer>
  </article>
  </div>
  </div>
</BaseLayout>

<style>
  .topic-layout {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 960px) {
    .topic-layout {
      grid-template-columns: 12rem minmax(0, 1fr);
      align-items: start;
    }
  }

  .topic__toc {
    display: none;
    position: sticky;
    top: var(--space-4);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-size: var(--font-size-sm);
  }

  @media (min-width: 960px) {
    .topic__toc {
      display: block;
    }
  }

  .topic__toc-title {
    margin: 0 0 var(--space-2);
    font-weight: 600;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.75rem;
  }

  .topic__toc ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topic__toc li + li {
    margin-top: var(--space-2);
  }

  .topic__toc a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .topic__toc a:hover {
    color: var(--color-accent-hover);
  }

  .topic {
    color: var(--color-text);
    margin-inline: auto;
    position: relative;
  }

  #lab {
    overflow-x: clip;
  }

  .topic__title {
    margin: 0 0 var(--space-4);
  }

  .topic nav a {
    color: var(--color-accent);
  }

  .topic nav a:hover {
    color: var(--color-accent-hover);
  }

  .topic nav a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: 2px;
  }

  .topic section {
    margin-block: var(--space-6);
  }

  .topic section:focus {
    outline: none;
  }

  .topic__footer {
    margin-block-start: var(--space-6);
    color: var(--color-muted);
  }

  .topic__footer a {
    color: var(--color-accent);
  }

  .topic__footer a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: 2px;
  }

  .topic__breadcrumbs a {
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .topic__breadcrumbs a:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  .topic__separator {
    color: var(--color-muted);
    opacity: 0.6;
    font-size: 0.75rem;
  }

  .topic__current {
    font-weight: 500;
    color: var(--color-muted);
  }
</style>
