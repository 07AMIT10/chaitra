---
import BaseLayout from "./BaseLayout.astro";
import MermaidInit from "../components/MermaidInit.tsx";
import "../styles/narrative.css";

const { title, repoFolder, pyodide = false, hasLab = false, hasCode = false } = Astro.props;
const PYODIDE_SCRIPT = "https://cdn.jsdelivr.net/pyodide/v0.26.4/full/pyodide.js";
---
<BaseLayout title={title}>
  {pyodide && (
    <script slot="head" src={PYODIDE_SCRIPT} defer></script>
  )}
  <a class="skip-link" href="#narrative">Skip to content</a>
  <nav class="topic__breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span class="topic__separator">/</span>
    <a href="/catalog">Catalog</a>
    <span class="topic__separator">/</span>
    <span class="topic__current">{title}</span>
  </nav>
  <article class="topic" aria-labelledby="topic-page-title">
    <h1 id="topic-page-title" class="topic__title">{title}</h1>
    <nav aria-label="Topic sections">
      <a href="#narrative">Story</a>
      {hasLab && <> · <a href="#lab">Lab</a></>}
      {hasCode && <> · <a href="#code">Code</a></>}
    </nav>
    {Astro.slots.has("hero") && (
      <section id="hero" aria-label="Overview">
        <slot name="hero" />
      </section>
    )}
    {Astro.slots.has("prerequisites") && (
      <section id="prerequisites" aria-label="Prerequisites">
        <slot name="prerequisites" />
      </section>
    )}
    <section id="narrative" aria-label="Topic narrative" tabindex="-1">
      <div class="topic__narrative prose">
        <slot name="narrative" />
      </div>
      <MermaidInit client:load />
    </section>
    {Astro.slots.has("lab") && (
      <section id="lab" aria-label="Interactive lab">
        <slot name="lab" />
      </section>
    )}
    {hasCode && (
      <section id="code" aria-label="Implementation code">
        <slot name="code" />
      </section>
    )}
    <footer class="topic__footer">
      <a href={`https://github.com/07AMIT10/chaitra/tree/main/${repoFolder}`}>View on GitHub</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .topic {
    color: var(--color-text);
    max-width: min(72ch, 100%);
    margin-inline: auto;
    position: relative;
  }

  #lab {
    max-width: 100%;
    overflow-x: clip;
  }

  .topic__title {
    margin: 0 0 var(--space-4);
    font-size: 1.75rem;
    line-height: 1.2;
  }

  .topic nav a {
    color: var(--color-accent);
  }

  .topic nav a:hover {
    color: var(--color-accent-hover);
  }

  .topic nav a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: 2px;
  }

  .topic section {
    margin-block: var(--space-6);
  }

  .topic section:focus {
    outline: none;
  }

  .topic__footer {
    margin-block-start: var(--space-6);
    color: var(--color-muted);
  }

  .topic__footer a {
    color: var(--color-accent);
  }

  .topic__footer a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: 2px;
  }

  .topic__breadcrumbs {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-block-end: var(--space-4);
    max-width: min(72ch, 100%);
    margin-inline: auto;
  }

  .topic__breadcrumbs a {
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .topic__breadcrumbs a:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  .topic__separator {
    color: var(--color-muted);
    opacity: 0.6;
    font-size: 0.75rem;
  }

  .topic__current {
    font-weight: 500;
    color: var(--color-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
