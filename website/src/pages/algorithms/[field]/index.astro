---
import AlgorithmsLayout from "../../../layouts/AlgorithmsLayout.astro";
import catalog from "../../../data/algorithms.json";

export function getStaticPaths() {
  return catalog.fields.map((field) => ({ params: { field: field.id } }));
}

const { field } = Astro.params;
const fieldMeta = catalog.fields.find((item) => item.id === field);
if (!fieldMeta) throw new Error(`Unknown algorithms field: ${field}`);

const items = catalog.algorithms.filter((item) => item.field === field);
---

<AlgorithmsLayout
  title={fieldMeta.label}
  oneLine={`Algorithms usually met in ${fieldMeta.label.toLowerCase()}, each taught through the mathematics underneath it.`}
  fieldLabel="Algorithms"
  wide={true}
  crumbs={[{ label: "Algorithms", href: "/algorithms" }, { label: fieldMeta.label }]}
>
  <section aria-labelledby="field-heading">
    <h2 id="field-heading">
      {items.length} algorithm{items.length === 1 ? "" : "s"} in {fieldMeta.label}
    </h2>
    <ul class="alg-field__cards">
      {items.map((item) => (
        <li>
          {item.hasPage ? (
            <a class="alg-field__card" href={`/algorithms/${item.field}/${item.slug}`}>
              <span class="alg-field__badge">{item.featured ? "Featured" : "Algorithm"}</span>
              <h3>{item.title}</h3>
              <p class="alg-field__one">{item.oneLine}</p>
              {item.reframe && <p class="alg-field__reframe">{item.reframe}</p>}
              {item.mathBranches.length > 0 && (
                <p class="alg-field__branches">{item.mathBranches.join(" · ")}</p>
              )}
            </a>
          ) : (
            <span class="alg-field__card alg-field__card--pending">
              <span class="alg-field__badge">Draft</span>
              <h3>{item.title}</h3>
              <p class="alg-field__one">Page not published yet.</p>
            </span>
          )}
        </li>
      ))}
    </ul>
    <p>
      <a href="/algorithms">← All fields and the full catalogue</a>
    </p>
  </section>
</AlgorithmsLayout>

<style>
  .alg-field__cards {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }

  .alg-field__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, var(--color-muted) 25%, transparent);
    background: var(--color-surface);
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .alg-field__card:hover {
    border-color: var(--color-algorithms, #a78bfa);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--color-algorithms, #a78bfa) 12%, transparent);
  }

  .alg-field__card--pending {
    opacity: 0.7;
  }

  .alg-field__badge {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-algorithms, #a78bfa);
  }

  .alg-field__card h3 {
    margin: 0;
    font-size: 1.1rem;
    color: var(--color-text);
  }

  .alg-field__one {
    margin: 0;
    color: var(--color-text);
    line-height: 1.55;
  }

  .alg-field__reframe {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--font-size-sm);
    line-height: 1.5;
  }

  .alg-field__branches {
    margin: auto 0 0;
    padding-top: var(--space-2);
    font-size: 0.75rem;
    color: var(--color-muted);
  }
</style>
