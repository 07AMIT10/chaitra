---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GameHub from "../../../components/game/GameHub.tsx";
import "../../../styles/game.css";
---

<BaseLayout bare title="The Long Repair — Algorithms">
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
  />
  <div class="game-page">
    <noscript>
      <p class="game-noscript">
        The Long Repair needs JavaScript to run its puzzle boards. The
        <a href="/algorithms">mathematics pages</a> do not.
      </p>
    </noscript>
    <GameHub client:visible />
  </div>
</BaseLayout>
