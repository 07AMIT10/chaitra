---
import BaseLayout from "../layouts/BaseLayout.astro";
import topics from "../data/topics.json";

const GITHUB_REPO = "https://github.com/07AMIT10/chaitra/tree/main";
---

<BaseLayout title="Catalog">
  <h1>Topic catalog</h1>
  <p>{topics.length} topics from the Chaitra curriculum.</p>
  <ul>
    {topics.map((t) => (
      <li>
        {t.status === "golden" || t.status === "live" || t.status === "preview" ? (
          <a href={`/topics/${t.slug}`}>{t.title}</a>
        ) : (
          <a href={`${GITHUB_REPO}/${t.folder}`}>{t.title}</a>
        )}
        {" "}
        <span class="status">({t.status})</span>
        {t.hasPython ? " Py" : ""}
        {t.hasRust ? " Rs" : ""}
      </li>
    ))}
  </ul>
</BaseLayout>
