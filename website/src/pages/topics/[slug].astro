---
import TopicLayout from "../../layouts/TopicLayout.astro";
import Callout from "../../components/mdx/Callout.astro";
import Details from "../../components/mdx/Details.astro";
import topics from "../../data/topics.json";

const mdxComponents = { Callout, Details };

export function getStaticPaths() {
  return topics
    .filter(
      (t) =>
        t.status === "golden" ||
        t.status === "live" ||
        t.status === "preview" ||
        t.status === "readme-only"
    )
    .map((t) => ({ params: { slug: t.slug }, props: { topic: t } }));
}

const { topic } = Astro.props;
const Content = (await import(`../../content/topics/${topic.slug}/index.mdx`)).default;

const codeModules = import.meta.glob<{ default: import("astro").MDXContent }>(
  "../../content/topics/*/code.mdx"
);
const loadCode = codeModules[`../../content/topics/${topic.slug}/code.mdx`];
const Code = loadCode ? (await loadCode()).default : null;
const hasCode = Code != null;
const hasLab = topic.hasLab === true;
---
<TopicLayout
  title={topic.title}
  repoFolder={topic.folder}
  topicSlug={topic.slug}
  pyodide={hasCode}
  hasLab={hasLab}
  hasCode={hasCode}
>
  <Content slot="narrative" components={mdxComponents} />
  {Code && <Code slot="code" components={mdxComponents} />}
</TopicLayout>
