---
import TopicLayout from "../../layouts/TopicLayout.astro";
import topics from "../../data/topics.json";

export function getStaticPaths() {
  return topics
    .filter((t) => t.status === "golden" || t.status === "live")
    .map((t) => ({ params: { slug: t.slug }, props: { topic: t } }));
}

const { topic } = Astro.props;
const Content = (await import(`../../content/topics/${topic.slug}/index.mdx`)).default;

const Code =
  topic.hasPython && topic.slug === "bloom-filters"
    ? (await import("../../content/topics/bloom-filters/code.mdx")).default
    : null;
---
<TopicLayout title={topic.title} repoFolder={topic.folder} pyodide={topic.hasPython === true}>
  <Content slot="narrative" />
  {Code && <Code slot="code" />}
</TopicLayout>
